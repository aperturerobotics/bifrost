{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "react"],
    "lib": ["ES2024", "DOM", "ESNext.Disposable"]
  },
  "include": ["*.ts", "*.tsx"]
}
